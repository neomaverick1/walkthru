{
  "name": "walkthru",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Property inspection app: room-by-room checklists, photo markup, move-in vs move-out comparison and branded PDF reports. Android, iPhone and web.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "android": "npm run build && cap sync android",
    "ios": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.73.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.94.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
